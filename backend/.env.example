# Environment Mode (production | development)
NODE_ENV=production

# Server Port (Render sets this automatically to 10000, local defaults to 3001)
PORT=3001

# Prisma database connection (Use Supabase Session/Transaction Pooler URL with port 6543 or 5432)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Direct DB connection (Used for migrations if running Prisma migrate)
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase Auth configuration (Get from Supabase Dashboard -> Project Settings -> API & Auth)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret"

# Frontend Origin for CORS (e.g. your Vercel deployment URL)
# Example: https://kinderly-lms.vercel.app
FRONTEND_URL="http://localhost:3000"
